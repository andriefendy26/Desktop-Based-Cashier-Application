  <property name="styleSheet">
   <string notr="true">
/* ── Global ── */
QDialog, QWidget#widget {
    background-color: #eaf2ff;
    color: #1e293b;
    font-family: "Segoe UI";
    font-size: 13px;
}

/* ── Left Panel ── */
QFrame#panel_left {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 16px;
}

/* ── Section Title ── */
QLabel#label_title {
    color: #1e3a8a;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

/* ── Field Labels ── */
QLabel {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    background: transparent;
}

/* ── Inputs ── */
QLineEdit {
    background-color: #f0f6ff;
    border: 1.5px solid #bfdbfe;
    border-radius: 10px;
    padding: 9px 13px;
    color: #1e293b;
    font-size: 13px;
}
QLineEdit:focus {
    border-color: #2563eb;
    background-color: #ffffff;
}

/* ── ComboBox ── */
QComboBox {
    background-color: #f0f6ff;
    border: 1.5px solid #bfdbfe;
    border-radius: 10px;
    padding: 9px 13px;
    color: #1e293b;
    font-size: 13px;
}
QComboBox:focus { border-color: #2563eb; }
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #2563eb;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    color: #1e293b;
    selection-background-color: #dbeafe;
    outline: none;
}

/* ── Table ── */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    gridline-color: #e5edfb;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    outline: none;
}
QHeaderView::section {
    background-color: #eff6ff;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid #2563eb;
}
QTableWidget::item {
    padding: 9px 14px;
    border-bottom: 1px solid #eef2f7;
}
QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}
QTableWidget::item:hover { background-color: #f0f6ff; }

QScrollBar:vertical {
    background: #eff6ff; width: 7px; border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #93c5fd; border-radius: 4px; min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Buttons ── */
QPushButton {
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    padding: 9px 18px;
}

QPushButton#simpan {
    background-color: #2563eb;
    color: #ffffff;
}
QPushButton#simpan:hover { background-color: #1d4ed8; }
QPushButton#simpan:pressed { background-color: #1e40af; }

QPushButton#edit {
    background-color: #eff6ff;
    color: #475569;
    border: 1.5px solid #bfdbfe;
}
QPushButton#edit:hover { border-color: #4f46e5; color: #4338ca; background-color: #e0e7ff; }

QPushButton#hapus {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1.5px solid #fca5a5;
}
QPushButton#hapus:hover { background-color: #dc2626; color: #fff; }

QPushButton#batal {
    background-color: #f1f5f9;
    color: #475569;
    border: 1.5px solid #cbd5e1;
}
QPushButton#batal:hover { border-color: #94a3b8; color: #1e293b; }

QPushButton#keluar {
    background-color: transparent;
    color: #2563eb;
    border: 1.5px solid #bfdbfe;
}
QPushButton#keluar:hover { border-color: #2563eb; color: #ffffff; background-color: #2563eb; }
   </string>
