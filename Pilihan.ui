QDialog {
    background-color: #eaf2ff;
}

QWidget#widget {
    background-color: #eaf2ff;
}

/* ── Card ── */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 20px;
}

/* ── Title ── */
QLabel#label_title {
    color: #1e3a8a;
    font-family: "Segoe UI";
    font-size: 22px;
    font-weight: 700;
    background: transparent;
}

QLabel#label_sub {
    color: #64748b;
    font-family: "Segoe UI";
    font-size: 12px;
    background: transparent;
}

QLabel#label_icon {
    background: transparent;
    font-size: 38px;
}

/* ── Divider ── */
QFrame#divider, QFrame#divider2, QFrame#divider3, QFrame#divider4 {
    background-color: #bfdbfe;
    border: none;
    max-height: 1px;
}

/* ── Checkout Button ── */
QPushButton#Checkout {
    background-color: #eff6ff;
    color: #1e3a8a;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 600;
    padding: 0px 20px;
    text-align: left;
}
QPushButton#Checkout:hover {
    background-color: #dbeafe;
    border-color: #2563eb;
    color: #1d4ed8;
}
QPushButton#Checkout:pressed {
    background-color: #bfdbfe;
}

/* ── Menu Button ── */
QPushButton#Menu {
    background-color: #eff6ff;
    color: #1e3a8a;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 600;
    padding: 0px 20px;
    text-align: left;
}
QPushButton#Menu:hover {
    background-color: #e0f2fe;
    border-color: #0ea5e9;
    color: #0369a1;
}
QPushButton#Menu:pressed {
    background-color: #bae6fd;
}

/* ── Laporan Button ── */
QPushButton#Lprn {
    background-color: #eff6ff;
    color: #1e3a8a;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 600;
    padding: 0px 20px;
    text-align: left;
}
QPushButton#Lprn:hover {
    background-color: #e0e7ff;
    border-color: #4f46e5;
    color: #4338ca;
}
QPushButton#Lprn:pressed {
    background-color: #c7d2fe;
}

/* ── Logout ── */
QPushButton#logout {
    background-color: transparent;
    color: #64748b;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 600;
}
QPushButton#logout:hover {
    background-color: #fee2e2;
    border-color: #ef4444;
    color: #ef4444;
}
QPushButton#logout:pressed {
    background-color: #fecaca;
}
</string>
