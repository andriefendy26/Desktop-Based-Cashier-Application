    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

QPushButton#keluar {
    background-color: #2563eb;
    color: #fff;
    border: none;
}
QPushButton#keluar:hover { background-color: #1d4ed8; }
QPushButton#keluar:pressed { background-color: #1e40af; }

/* ─── Table Widget ─── */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    gridline-color: #e5edfb;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    outline: none;
}

QHeaderView::section {
    background-color: #eff6ff;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #2563eb;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #e5edfb;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
    border-radius: 4px;
}

QTableWidget::item:hover {
    background-color: #eff6ff;
}

QScrollBar:vertical {
    background: #eff6ff;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #93c5fd;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #eff6ff;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #93c5fd;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
