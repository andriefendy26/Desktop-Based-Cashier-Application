                 <item>
                  <widget class="QWidget" name="widget" native="true">
                   <property name="styleSheet">
                    <string notr="true">QWidget#widget{ background-color: #eef3fa; }
QLabel{ color:#6b7a90; font-size:10px; font-weight:700; letter-spacing:1px; background:transparent; }
QLabel#label_2{ color:#14306b; font-size:18px; font-weight:700; letter-spacing:0px; }
QLineEdit, QComboBox{
	background-color:#f5f8fd; border:1px solid #d5e0ef; border-radius:9px;
	color:#1e293b; padding:8px 12px; font-size:13px; font-weight:400; letter-spacing:0px;
}
QLineEdit:focus, QComboBox:focus{ border-color:#2563eb; background-color:#ffffff; }
QComboBox::drop-down{ border:none; width:22px; }
QComboBox::down-arrow{
	image:none; border-left:5px solid transparent; border-right:5px solid transparent;
	border-top:6px solid #2563eb; margin-right:8px;
}
QComboBox QAbstractItemView{
	background-color:#ffffff; border:1px solid #d5e0ef; border-radius:8px;
	selection-background-color:#e7effb; outline:none;
}
QFrame#panel_form{ background-color:#ffffff; border:1px solid #e0e7f2; border-radius:14px; }
QTableWidget{
	background-color:#ffffff; border:1px solid #e0e7f2; border-radius:12px;
	gridline-color:#eef2f8; color:#1e293b; font-size:13px;
	selection-background-color:#e7effb; selection-color:#14306b; outline:none;
}
QHeaderView::section{
	background-color:#f5f8fd; color:#1d4ed8; font-size:11px; font-weight:700;
	letter-spacing:0.8px; padding:9px 12px; border:none; border-bottom:1px solid #dbe4f1;
}
QPushButton{ border-radius:9px; padding:9px 16px; font-size:13px; font-weight:600; border:none; }
QPushButton#simpan{ background-color:#2563eb; color:#ffffff; }
QPushButton#simpan:hover{ background-color:#1d4ed8; }
QPushButton#edit{ background-color:#f5f8fd; color:#475569; border:1px solid #d5e0ef; }
QPushButton#edit:hover{ background-color:#e7effb; color:#1d4ed8; border-color:#2563eb; }
QPushButton#hapus{ background-color:#fdf1f0; color:#c0392f; border:1px solid #f3cdc9; }
QPushButton#hapus:hover{ background-color:#c0392f; color:#ffffff; border-color:#c0392f; }
QPushButton#batal{ background-color:#f4f6f9; color:#475569; border:1px solid #dfe5ec; }
QPushButton#batal:hover{ border-color:#94a3b8; color:#1e293b; }
QSplitter::handle{ background:transparent; }
QSplitter::handle:horizontal{ width:14px; }</string>
                   </property>

