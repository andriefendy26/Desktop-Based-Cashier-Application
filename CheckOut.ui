  <property name="styleSheet">
   <string notr="true">
/* ─── Global ─── */
QDialog, QWidget#widget {
    background-color: #eaf2ff;
    color: #1e293b;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
}

/* ─── Frame (panel kanan) ─── */
QFrame#frame {
    background-color: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
}

/* ─── Labels ─── */
QLabel {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QLabel#label {
    color: #1e3a8a;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}

QLabel#label_6, QLabel#label_7, QLabel#label_8 {
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#lbl_makanan {
    color: #eb2525;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#lbl_minuman {
    color: #0891b2;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

/* ─── Line Edits ─── */
QLineEdit {
    background-color: #f0f6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #93c5fd;
}

QLineEdit:focus {
    border: 1.5px solid #2563eb;
    background-color: #ffffff;
}

QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QLineEdit#totalbayar, QLineEdit#kembalian {
    color: #1d4ed8;
    font-weight: 700;
    font-size: 14px;
}

/* ─── Search Bars ─── */
QLineEdit#search_makanan {
    background-color: #eff6ff;
    border: 1px solid #2563eb;
    border-radius: 8px;
    padding: 5px 10px 5px 28px;
    color: #1d4ed8;
    font-size: 12px;
}
QLineEdit#search_makanan:focus {
    border: 1.5px solid #2563eb;
    background-color: #dbeafe;
}

QLineEdit#search_minuman {
    background-color: #e0f7fa;
    border: 1px solid #0891b2;
    border-radius: 8px;
    padding: 5px 10px 5px 28px;
    color: #0e7490;
    font-size: 12px;
}
QLineEdit#search_minuman:focus {
    border: 1.5px solid #0891b2;
    background-color: #cffafe;
}

/* ─── Buttons ─── */
QPushButton {
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

QPushButton#simpan {
    background-color: #2563eb;
    color: #ffffff;
}
QPushButton#simpan:hover { background-color: #1d4ed8; }
QPushButton#simpan:pressed { background-color: #1e40af; }

QPushButton#bayar {
    background-color: #1d4ed8;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    border-radius: 10px;
}
QPushButton#bayar:hover { background-color: #2563eb; }
QPushButton#bayar:pressed { background-color: #1e3a8a; }

QPushButton#hapus {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fca5a5;
}
QPushButton#hapus:hover { background-color: #dc2626; color: #ffffff; }

QPushButton#edit_item {
    background-color: #e0e7ff;
    color: #4338ca;
    border: 1px solid #a5b4fc;
}
QPushButton#edit_item:hover { background-color: #4f46e5; color: #ffffff; }
QPushButton#edit_item:pressed { background-color: #4338ca; }

QPushButton#batal {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
}
QPushButton#batal:hover { background-color: #e2e8f0; color: #1e293b; }

QPushButton#keluar {
    background-color: #2563eb;
    color: #fff;
    border: none;
}
QPushButton#keluar:hover { background-color: #1d4ed8; }
QPushButton#keluar:pressed { background-color: #1e3a8a; }

/* ─── Table Widgets ─── */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f8fd;
    border: 1px solid #e0e7f2;
    border-radius: 12px;
    gridline-color: #eef2f8;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #e7effb;
    selection-color: #14306b;
    outline: none;
}

QHeaderView {
    background-color: #ffffff;
}

QHeaderView::section {
    background-color: transparent;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #2563eb;
}

QTableWidget#table_makanan QHeaderView::section {
    background-color: transparent;
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}

QTableWidget#table_minuman QHeaderView::section {
    background-color: transparent;
    color: #0891b2;
    border-bottom: 2px solid #0891b2;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #e5edfb;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
    border-radius: 4px;
}

QTableWidget::item:hover {
    background-color: #eff6ff;
}

QScrollBar:vertical {
    background: #eff6ff;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #93c5fd;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #eff6ff;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #93c5fd;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QFrame#line, QFrame#line_2 {
    color: #bfdbfe;
    background-color: #bfdbfe;
}
   </string>
