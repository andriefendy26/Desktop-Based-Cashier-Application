  <property name="styleSheet">
   <string notr="true">
/* ─── Global ─── */
QDialog, QWidget#widget {
    background-color: #0f1117;
    color: #e2e8f0;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
}

/* ─── Frame (panel kanan) ─── */
QFrame#frame {
    background-color: #1a1f2e;
    border: 1px solid #2d3548;
    border-radius: 14px;
}

/* ─── Labels ─── */
QLabel {
    color: #94a3b8;
    font-size: 12px;
    background: transparent;
}

QLabel#label {
    color: #f1f5f9;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}

QLabel#label_6, QLabel#label_7, QLabel#label_8 {
    color: #38bdf8;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#lbl_makanan {
    color: #f97316;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#lbl_minuman {
    color: #34d399;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

/* ─── Line Edits ─── */
QLineEdit {
    background-color: #252d3d;
    border: 1px solid #2d3548;
    border-radius: 8px;
    padding: 6px 10px;
    color: #f1f5f9;
    font-size: 13px;
    selection-background-color: #38bdf8;
}

QLineEdit:focus {
    border: 1.5px solid #38bdf8;
    background-color: #1e2a3a;
}

QLineEdit:disabled {
    background-color: #1a1f2e;
    color: #4b5563;
    border-color: #22283a;
}

QLineEdit#totalbayar, QLineEdit#kembalian {
    color: #34d399;
    font-weight: 700;
    font-size: 14px;
}

/* ─── Buttons ─── */
QPushButton {
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

QPushButton#simpan {
    background-color: #1e40af;
    color: #e0f2fe;
}
QPushButton#simpan:hover { background-color: #2563eb; }
QPushButton#simpan:pressed { background-color: #1d4ed8; }

QPushButton#bayar {
    background-color: #059669;
    color: #ecfdf5;
    font-size: 15px;
    font-weight: 700;
    border-radius: 10px;
}
QPushButton#bayar:hover { background-color: #10b981; }
QPushButton#bayar:pressed { background-color: #047857; }

QPushButton#hapus {
    background-color: #7f1d1d;
    color: #fca5a5;
    border: 1px solid #991b1b;
}
QPushButton#hapus:hover { background-color: #991b1b; }

QPushButton#batal {
    background-color: #374151;
    color: #d1d5db;
    border: 1px solid #4b5563;
}
QPushButton#batal:hover { background-color: #4b5563; }

QPushButton#keluar {
    background-color: #dc2626;
    color: #fff;
    border: none;
}
QPushButton#keluar:hover { background-color: #ef4444; }

/* ─── Table Widgets ─── */
QTableWidget {
    background-color: #1a1f2e;
    border: 1px solid #2d3548;
    border-radius: 10px;
    gridline-color: #222840;
    color: #e2e8f0;
    font-size: 13px;
    selection-background-color: #1e3a5f;
    selection-color: #e0f2fe;
    outline: none;
}

QHeaderView::section {
    background-color: #141824;
    color: #38bdf8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #38bdf8;
}

/* Header makanan — oranye */
QTableWidget#table_makanan QHeaderView::section {
    color: #f97316;
    border-bottom: 2px solid #f97316;
}

/* Header minuman — hijau */
QTableWidget#table_minuman QHeaderView::section {
    color: #34d399;
    border-bottom: 2px solid #34d399;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1e2436;
}

QTableWidget::item:selected {
    background-color: #1e3a5f;
    color: #e0f2fe;
    border-radius: 4px;
}

QTableWidget::item:hover {
    background-color: #1e2d45;
}

QScrollBar:vertical {
    background: #141824;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #38bdf8;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #141824;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #38bdf8;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ─── Separator ─── */
QFrame#line, QFrame#line_2 {
    color: #2d3548;
    background-color: #2d3548;
}
   </string>
